# Server Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_long_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=production
CLIENT_URL=https://dashboard.orillusive.com

# Safepay Payment Gateway Configuration (Vercel Backend Variables ONLY)
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=sec_...
SAFEPAY_SECRET_KEY=sec_...
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret

# Client Configuration (Vite)
VITE_API_URL=https://server.dashboard.orillusive.com/api
